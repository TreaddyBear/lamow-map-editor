{
  "name": "lamow-map-editor",
  "version": "0.100.0",
  "description": "",
  "scripts": {
    "dev": "pnpm build:renderer && vite --host 127.0.0.1 --port 5191",
    "dev:e2e": "pnpm build:renderer && vite --mode e2e --host 127.0.0.1 --port 5192 --strictPort",
    "build:renderer": "pnpm --filter @lamow/landscape-renderer build",
    "build": "pnpm build:renderer && tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "test": "pnpm build:renderer && vite build --ssr tests/domain.test.ts --outDir .tmp/domain-tests --emptyOutDir && node --test .tmp/domain-tests/domain.test.js && node --test tests/vegetation-runtime.test.mjs tests/vegetation-library.test.mjs tests/vegetation-modifiers.test.mjs tests/game-maps.test.mjs",
    "audit:modifiers": "pnpm build:renderer && node scripts/audit-vegetation-modifiers.mjs",
    "test:e2e": "pnpm build:renderer && playwright test",
    "test:e2e:headed": "pnpm build:renderer && playwright test --headed",
    "test:e2e:debug": "pnpm build:renderer && playwright test --headed --debug",
    "sync:game-assets": "node scripts/sync-game-assets.mjs"
  },
  "packageManager": "pnpm@11.1.3",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "@lamow/landscape-renderer": "workspace:*",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0"
  }
}
